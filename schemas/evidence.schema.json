{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence.schema.json",
  "type": "object",
  "properties": {
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "period": {
            "enum": [
              "recent",
              "long_term",
              "unclear"
            ]
          },
          "behaviorExample": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "counterEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 0,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "quote",
          "period"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "observations"
  ],
  "additionalProperties": false
}
